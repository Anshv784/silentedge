# Copy to .env and fill in. NEVER commit .env.
#
# This file must never contain a private key, seed phrase, or keypair path
# pointing at a funded wallet. The backend is untrusted by design (ARCHITECTURE.md
# §2) and holds no key that can move user funds.

# --- Solana ---
# Use a dedicated RPC provider. Default public endpoints drop transactions
# during Arcium deployment (docs/research.md §2.1).
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet

# --- Arcium ---
# Cluster offset: 456 = devnet, 2026 = mainnet.
# This value is ALSO compiled into the vault program as EXPECTED_CLUSTER.
# Changing it here without changing it there will (correctly) halt evaluations.
ARCIUM_CLUSTER_OFFSET=456

# --- Jupiter ---
# Router path (/build) — required for CPI composability. See docs/research.md §4.
JUPITER_API_URL=https://api.jup.ag/swap/v2
JUPITER_API_KEY=
# Caps route complexity so the CPI fits without Address Lookup Tables.
JUPITER_MAX_ACCOUNTS=24

# --- Pyth ---
PYTH_HERMES_URL=https://hermes.pyth.network
# Optional. Pyth retired the browser-callable TradingView shim on 26 Aug 2026;
# candles now go through apps/web/app/api/candles/ on the server. With this key
# that relay uses Pyth's official Pro History API and gets unlimited history;
# without it, it falls back to a public endpoint capped at 30 days.
# SERVER-SIDE ONLY — Pyth's docs are explicit that this must never reach a
# browser, which is why it has no NEXT_PUBLIC_ prefix.
PYTH_PRO_API_KEY=
# SOL/USD feed id
PYTH_SOL_USD_FEED_ID=

# --- Frontend ---
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_VAULT_PROGRAM_ID=
